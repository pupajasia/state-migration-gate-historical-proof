{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:state-migration-gate:contract:1",
  "title": "Desktop State Migration Gate contract",
  "type": "object",
  "required": ["contract_version", "paths"],
  "properties": {
    "$schema": {"type": "string"},
    "contract_version": {"const": 1},
    "project": {"type": "string", "minLength": 1},
    "fail_on_flaky": {"type": "boolean", "default": true},
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/upgradePath"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "commandStep": {
      "type": "object",
      "required": ["command"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "expected_exit": {"type": "integer", "default": 0}
      },
      "additionalProperties": false
    },
    "assertion": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": {"type": "string"},
        "op": {
          "enum": ["equals", "not_equals", "exists", "truthy"],
          "default": "equals"
        },
        "value": true
      },
      "additionalProperties": false
    },
    "upgradePath": {
      "type": "object",
      "required": ["id", "seed", "verify"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "from": {"type": "string"},
        "to": {"type": "string"},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 900, "default": 60},
        "retries": {"type": "integer", "minimum": 0, "maximum": 2, "default": 0},
        "seed": {"$ref": "#/$defs/commandStep"},
        "verify": {"$ref": "#/$defs/commandStep"},
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/assertion"}
        }
      },
      "additionalProperties": false
    }
  }
}
